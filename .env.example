# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está en .gitignore: nunca se sube al repositorio.

# Access key de Web3Forms (https://web3forms.com — gratis, solo pide tu correo).
# Es pública por diseño: viaja en el HTML y lo único que autoriza es enviar
# correo al buzón que la registró.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Subruta donde se publica el sitio.
#   repo <usuario>.github.io  -> dejar vacío
#   repo cv                   -> /cv
NEXT_PUBLIC_BASE_PATH=

# URL pública completa. Solo se usa para los metadatos de Open Graph.
NEXT_PUBLIC_SITE_URL=
